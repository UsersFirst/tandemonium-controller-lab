{
  "name": "tandemonium-controller-lab",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "start:lobby": "npm run start:lobby --workspace @usersfirst/overlay",
    "face-painter": "npx -y serve tools/face-painter",
    "split-glb": "node tools/split-glb.js",
    "hid-probe": "npx -y serve tools/hid-probe",
    "hid-dump": "node tools/hid-serial-dump.mjs",
    "steam-multi-probe": "node tools/steam-multi-probe.mjs",
    "inventory-preview": "npx -y serve .",
    "typecheck": "tsc -p packages/ui/tsconfig.json",
    "ui:audit": "node tools/ui-audit/ui-audit.mjs",
    "ui:screenboard": "node tools/screenboard/screenboard.mjs",
    "ui:new-element": "node tools/ui-kit/new-element.mjs",
    "ui:gallery": "npx -y serve .",
    "ui:inventory": "node tools/ui-inventory/ui-inventory.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "meshoptimizer": "^0.20.0",
    "typescript": "^5.4.5"
  }
}
